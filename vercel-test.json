{
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/live-match-tick",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/finalize-scores",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/settle-contests",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron/archive-server-logs",
      "schedule": "0 2 * * *"
    }
  ]
}
